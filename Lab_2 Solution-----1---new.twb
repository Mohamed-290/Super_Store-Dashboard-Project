    <dashboard name='Story_10' type='storyboard'>
      <style>
        <style-rule element='story-description'>
          <format attr='background-color' id='story-description_6' value='#034c8c' />
          <format attr='vertical-align' id='story-description_6' value='center' />
          <format attr='text-align' id='story-description_6' value='center' />
          <format attr='border-width' id='story-description_6' value='5' />
          <format attr='border-color' id='story-description_6' value='#000000' />
        </style-rule>
        <style-rule element='story-point-caption'>
          <format attr='width' value='562' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98120' id='1' param='vert' removable='false' type-v2='layout-flow' w='99032' x='484' y='940'>
            <zone h='4935' id='3' type-v2='title' w='99032' x='484' y='940' />
            <zone h='11868' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99032' x='484' y='5875' />
            <zone h='81317' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99032' x='484' y='17743'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='What management action would you recommend based on your dashboard?' captured-sheet='' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='90093' id='6' story-point-id='1' type-v2='text' w='96166' x='742' y='15268'>
          <formatted-text>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>1- We stop the sub_category that isn’t making profits, like </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>tables</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>, </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>supplies</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>, and </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>bookcases</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>2- We want to focus on states like </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>Texas</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>, </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>Ohio</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>, </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>Florida</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>, </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>Illinois</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>, and </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>Pennsylvania</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'> because they generate passive income.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>3- We want to focus on </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>January</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'> and </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>February</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'> because sales in those months have been low over the past years.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>4- We focus on the</run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'> Region / the Sub_Category </run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>that achieves a negative </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>profit margin</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>5- We need to focus on </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>customers</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'> who generate big sales but don&apos;t make </run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'>profits</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>.</run>
            <run fontalignment='0'>Æ&#10;&#10;</run>
            <run bold='true' fontalignment='0' fontcolor='#ffffff' fontname='Tableau Bold'>6- We need to focus on the number of</run>
            <run bold='true' fontalignment='0' fontcolor='#bf1744' fontname='Tableau Bold'> shipping days</run>
